---
// Über uns als Scroll-Geschichte (gleiche Bühne wie Start- und Leistungsseiten, Zeitachse "about"
// in src/scripts/story/timeline.ts). Das Team wird ohne Namen über seine Schwerpunkte vorgestellt.
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ChapterNav from '../components/ChapterNav.astro';
import StoryLoader from '../components/StoryLoader.astro';
import Illustration from '../components/Illustration.astro';
import imgTeam from '../assets/plates/team.svg';
import { team } from '../data/about';

const nr = (i: number) => String(i + 1).padStart(2, '0');

const competences = [
  { title: 'Unternehmen & Prozesse', text: 'Unsere Erfahrung aus Unternehmens- und SAP-Beratung hilft uns, Geschäftsabläufe zu verstehen, Anforderungen zu strukturieren und sinnvolle Prioritäten zu setzen.' },
  { title: 'Design & Kommunikation', text: 'Wir übersetzen dein Angebot in einen klaren digitalen Auftritt. Mit Websites, Inhalten und Social Media machen wir verständlich, was dein Unternehmen auszeichnet.' },
  { title: 'KI & Automatisierung', text: 'Wir identifizieren geeignete Einsatzmöglichkeiten, wählen passende Werkzeuge aus und integrieren sie in bestehende Abläufe. Dazu gehört auch, dein Team mit den neuen Lösungen vertraut zu machen.' },
];

const chapters = [
  { id: 'start', label: 'Start' },
  { id: 'blick', label: 'Unser Blick' },
  { id: 'zusammenarbeit', label: 'Zusammenarbeit' },
  { id: 'team', label: 'Unser Team' },
];
---
<Base title="Über uns – GRAVN Digital" description="GRAVN verbindet Unternehmensberatung, Design und Technologie. Lerne unser Team und unsere Arbeitsweise kennen.">
  <div class="story" data-story="about">
    <div class="story-stage" aria-hidden="true"><canvas id="story-canvas"></canvas></div>

    <section class="hero chapter chapter-intro service-hero" data-chapter="hero" id="start">
      <div class="container">
        <p class="eyebrow">Über GRAVN</p>
        <h1 class="display">Unternehmerisch denken.<br />Digital umsetzen<span class="gv-accent">.</span></h1>
        <div class="two-col hero-text">
          <p class="lead">GRAVN verbindet Unternehmensberatung, Design und Technologie. Wir bringen Erfahrung aus Unternehmens- und SAP-Beratung, Webdesign, KI, Marketing und Social Media zusammen.</p>
          <p class="lead">Gemeinsam unterstützen wir Unternehmen dabei, ihren digitalen Auftritt zu stärken, passende Kunden zu erreichen und Arbeitsabläufe zu verbessern.</p>
        </div>
        <div class="illustration-wide hero-fallback"><Illustration src={imgTeam} alt="Isometrische Linienzeichnung: drei Figuren stehen um einen Stapel aus drei Ebenen, feine Linien verbinden jede Figur mit dem Stapel" size="wide" zoom="always" loading="eager" /></div>
      </div>
    </section>

    <section class="chapter chapter-step" data-chapter="blick" id="blick" aria-labelledby="kompetenzen">
      <div class="container chapter-grid">
        <div class="chapter-text">
          <p class="gv-eyebrow"><span class="gv-eyebrow-index">01</span><span aria-hidden="true"> / </span>Unser Blick</p>
          <h2 class="heading-1" id="kompetenzen">Unterschiedliche Kompetenzen.<br />Ein gemeinsamer Blick auf dein Unternehmen.</h2>
          <p class="lead">Eine Website muss dein Angebot verständlich machen. Marketing muss die richtigen Menschen erreichen. Und neue Technologien müssen sich im Arbeitsalltag bewähren.</p>
          <p class="lead">Deshalb betrachten wir diese Aufgaben im Zusammenhang. Wir beschäftigen uns mit deinem Geschäftsmodell, deiner Zielgruppe und deinen Abläufen. Daraus entwickeln wir Lösungen, die zusammenpassen – vom ersten Konzept bis zur technischen Umsetzung.</p>
          <ol class="chapter-list">
            {competences.map((c, i) => (
              <li>
                <span class="chapter-list-index">{nr(i)}</span>
                <div>
                  <h3 class="gv-step-title">{c.title}</h3>
                  <p class="gv-step-text">{c.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="chapter chapter-step" data-chapter="zusammenarbeit" id="zusammenarbeit" aria-labelledby="zusammenarbeit-title">
      <div class="container chapter-grid">
        <div class="chapter-text">
          <p class="gv-eyebrow"><span class="gv-eyebrow-index">02</span><span aria-hidden="true"> / </span>Zusammenarbeit</p>
          <h2 class="heading-1" id="zusammenarbeit-title">So arbeiten wir mit dir.</h2>
          <ol class="chapter-list">
            <li><span class="chapter-list-index">01</span><p class="chapter-list-text">Am Anfang stehen dein Vorhaben und die Frage, was sich konkret verbessern soll. Gemeinsam legen wir Ziele, Umfang und Prioritäten fest.</p></li>
            <li><span class="chapter-list-index">02</span><p class="chapter-list-text">Während der Umsetzung hast du einen festen Ansprechpartner, erhältst Einblick in die Fortschritte und kannst Entscheidungen nachvollziehen. Zum Abschluss sorgen wir für eine verständliche Übergabe und besprechen, welche Betreuung anschließend sinnvoll ist.</p></li>
          </ol>
        </div>
      </div>
    </section>

    <section class="chapter chapter-step" data-chapter="team" id="team" aria-labelledby="team-title">
      <div class="container">
        <SectionHeading index="03" eyebrow="Unser Team" align="stacked">
          <Fragment slot="title"><span id="team-title">Klein im Team.<br />Klar in der Verantwortung.</span></Fragment>
        </SectionHeading>
        <p class="lead team-intro">{team.intro}</p>
        <ol class="two-col two-col-numbered">
          {team.areas.map((a, i) => (
            <li>
              <span class="two-col-index">{nr(i)}</span>
              <h3 class="gv-step-title">{a.title}</h3>
              <p class="lead">{a.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <ChapterNav items={chapters} label="Kapitel der Seite Über uns" />
  </div>

  <section class="section" data-theme="dark" aria-labelledby="cta-title">
    <div class="container cta-block">
      <p class="gv-eyebrow" style="margin-bottom:var(--space-6)"><span class="gv-eyebrow-index">04</span><span aria-hidden="true"> / </span>Kontakt</p>
      <h2 class="heading-1" id="cta-title" style="max-width:20ch;margin:0 0 var(--space-6)">Was möchtest du in deinem Unternehmen verbessern?</h2>
      <p class="lead">Erzähl uns, wo du stehst und was du vorhast. Wir besprechen gemeinsam, welcher nächste Schritt sinnvoll ist.</p>
      <Button href="/kontakt">Projekt besprechen</Button>
    </div>
  </section>
  <StoryLoader />
</Base>
