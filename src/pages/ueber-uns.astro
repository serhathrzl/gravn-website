---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProcessStep from '../components/ProcessStep.astro';
import PersonCard from '../components/PersonCard.astro';
import { about } from '../data/about';
---
<Base title="Über uns – GRAVN Digital" description="GRAVN verbindet Unternehmensberatung, Design und Technologie. Lerne unser Team und unsere Arbeitsweise kennen.">
  <section class="section page-head">
    <div class="container">
      <p class="eyebrow">Über GRAVN</p>
      <h1 class="display">Unternehmerisch denken.<br />Digital umsetzen<span class="gv-accent">.</span></h1>
      <div class="two-col">
        <p class="lead">GRAVN verbindet Unternehmensberatung, Design und Technologie. Wir bringen Erfahrung aus Unternehmens- und SAP-Beratung, Webdesign, KI, Marketing und Social Media zusammen.</p>
        <p class="lead">Gemeinsam unterstützen wir Unternehmen dabei, ihren digitalen Auftritt zu stärken, passende Kunden zu erreichen und Arbeitsabläufe zu verbessern.</p>
      </div>
    </div>
  </section>

  <section class="section" data-theme="dark" aria-labelledby="kompetenzen">
    <div class="container">
      <SectionHeading index="01" eyebrow="Unser Blick">
        <Fragment slot="title"><span id="kompetenzen">Unterschiedliche Kompetenzen.<br />Ein gemeinsamer Blick auf dein Unternehmen.</span></Fragment>
        <Fragment slot="intro">Eine Website muss dein Angebot verständlich machen. Marketing muss die richtigen Menschen erreichen. Und neue Technologien müssen sich im Arbeitsalltag bewähren.</Fragment>
      </SectionHeading>
      <p class="about-text">Deshalb betrachten wir diese Aufgaben im Zusammenhang. Wir beschäftigen uns mit deinem Geschäftsmodell, deiner Zielgruppe und deinen Abläufen. Daraus entwickeln wir Lösungen, die zusammenpassen – vom ersten Konzept bis zur technischen Umsetzung.</p>
      <ol class="grid-3" style="padding:0;list-style:none">
        <ProcessStep number="01" title="Unternehmen & Prozesse" text="Unsere Erfahrung aus Unternehmens- und SAP-Beratung hilft uns, Geschäftsabläufe zu verstehen, Anforderungen zu strukturieren und sinnvolle Prioritäten zu setzen." />
        <ProcessStep number="02" title="Design & Kommunikation" text="Wir übersetzen dein Angebot in einen klaren digitalen Auftritt. Mit Websites, Inhalten und Social Media machen wir verständlich, was dein Unternehmen auszeichnet." />
        <ProcessStep number="03" title="KI & Automatisierung" text="Wir identifizieren geeignete Einsatzmöglichkeiten, wählen passende Werkzeuge aus und integrieren sie in bestehende Abläufe. Dazu gehört auch, dein Team mit den neuen Lösungen vertraut zu machen." />
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="zusammenarbeit">
    <div class="container">
      <SectionHeading index="02" eyebrow="Zusammenarbeit">
        <Fragment slot="title"><span id="zusammenarbeit">So arbeiten wir mit dir.</span></Fragment>
      </SectionHeading>
      <div class="two-col">
        <p class="lead">Am Anfang stehen dein Vorhaben und die Frage, was sich konkret verbessern soll. Gemeinsam legen wir Ziele, Umfang und Prioritäten fest.</p>
        <p class="lead">Während der Umsetzung hast du einen festen Ansprechpartner, erhältst Einblick in die Fortschritte und kannst Entscheidungen nachvollziehen. Zum Abschluss sorgen wir für eine verständliche Übergabe und besprechen, welche Betreuung anschließend sinnvoll ist.</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0" aria-labelledby="team">
    <div class="container">
      <SectionHeading index="03" eyebrow="Menschen">
        <Fragment slot="title"><span id="team">Das Team.<br />Mit Gesicht.</span></Fragment>
        {about.intro && <Fragment slot="intro">{about.intro}</Fragment>}
      </SectionHeading>
      {about.people.length
        ? <div class="grid-3">{about.people.map((p) => <PersonCard {...p} />)}</div>
        : <p class="about-text"><span class="placeholder">Platzhalter: Namen, Rollen, optional Foto (keine Stockfotos)</span></p>}
    </div>
  </section>

  <section class="section" data-theme="dark" aria-labelledby="cta-title">
    <div class="container cta-block">
      <p class="gv-eyebrow" style="margin-bottom:var(--space-6)"><span class="gv-eyebrow-index">04</span><span aria-hidden="true"> / </span>Kontakt</p>
      <h2 class="heading-1" id="cta-title" style="max-width:20ch;margin:0 0 var(--space-6)">Was möchtest du in deinem Unternehmen verbessern?</h2>
      <p class="lead">Erzähl uns, wo du stehst und was du vorhast. Wir besprechen gemeinsam, welcher nächste Schritt sinnvoll ist.</p>
      <Button href="/kontakt">Projekt besprechen</Button>
    </div>
  </section>
</Base>
