---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PersonCard from '../components/PersonCard.astro';
import { about } from '../data/about';
---
<Base title="Über uns – GRAVN Digital" description="Ein Studio, drei Disziplinen: Websites, Marketing und KI. Lerne uns und unsere Haltung kennen.">
  <section class="section page-head">
    <div class="container">
      <p class="eyebrow">Über uns</p>
      <h1 class="display">Ein Studio.<br />Drei Disziplinen<span class="gv-accent">.</span></h1>
      {about.intro
        ? <p class="lead" style="max-width:var(--measure);color:var(--text-secondary);margin-top:var(--space-6)">{about.intro}</p>
        : <p class="about-text"><span class="placeholder">Platzhalter: Wer seid ihr, wie viele, seit wann, warum GRAVN</span></p>}
    </div>
  </section>

  <section class="section" data-theme="dark" aria-labelledby="haltung">
    <div class="container">
      <SectionHeading index="01" eyebrow="Unsere Haltung">
        <Fragment slot="title"><span id="haltung">Klar im Wort.<br />Ehrlich im Rat.</span></Fragment>
        <Fragment slot="intro">Wir arbeiten klar, ehrlich und ohne Fachchinesisch. Wir sagen, was wir können, und was nicht. Wir bauen Dinge, die zu dir passen und nicht zu einer Vorlage.</Fragment>
      </SectionHeading>
    </div>
  </section>

  <section class="section" aria-labelledby="team">
    <div class="container">
      <SectionHeading index="02" eyebrow="Menschen">
        <Fragment slot="title"><span id="team">Das Team.<br />Mit Gesicht.</span></Fragment>
      </SectionHeading>
      {about.people.length
        ? <div class="grid-3">{about.people.map((p) => <PersonCard {...p} />)}</div>
        : <p class="about-text"><span class="placeholder">Platzhalter: Namen, Rollen, optional Foto (keine Stockfotos)</span></p>}
      <Button href="/kontakt">Projekt besprechen</Button>
    </div>
  </section>
</Base>
