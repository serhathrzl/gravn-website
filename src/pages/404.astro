---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---
<Base title="Seite nicht gefunden – GRAVN Digital" description="Diese Seite gibt es nicht." noindex>
  <section class="section page-head">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 class="display">Seite nicht gefunden<span class="gv-accent">.</span></h1>
      <p class="lead" style="max-width:var(--measure);color:var(--text-secondary);margin:var(--space-6) 0">Den Link gibt es nicht mehr oder er war falsch.</p>
      <Button href="/">Zur Startseite</Button>
    </div>
  </section>
</Base>
