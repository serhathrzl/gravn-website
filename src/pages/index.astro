---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProcessStep from '../components/ProcessStep.astro';
import { about } from '../data/about';
import { processSteps } from '../data/process';
import Illustration from '../components/Illustration.astro';
import imgWebsites from '../assets/illustrations/websites.png';
import imgMarketing from '../assets/illustrations/marketing.png';
import imgKi from '../assets/illustrations/ki.png';
---
<Base
  title="GRAVN Digital – Websites, Marketing und KI für wachsende Marken"
  description="Wir bauen Websites, machen Marken sichtbar und nehmen dir Routine ab. Drei Disziplinen, ein Ansprechpartner."
>
  <section class="hero section">
    <div class="container">
      <p class="eyebrow">Websites / Marketing / AI</p>
      <h1 class="display">Digital denken.<br />Mehr bewegen<span class="gv-accent">.</span></h1>
      <div class="hero-lower">
        <div>
          <p class="lead">Wir entwickeln Websites, die überzeugen, stärken deine Sichtbarkeit mit Marketing und Social Media und vereinfachen deine Abläufe mit KI. Von der ersten Idee bis zur Umsetzung begleiten wir dich mit Lösungen, die zu deinem Unternehmen, deinen Zielen und deinem Team passen.</p>
          <div class="hero-actions">
            <Button href="/kontakt">Projekt besprechen</Button>
            <Button variant="link" href="#leistungen">Leistungen entdecken</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="leistungen" aria-labelledby="leistungen-title">
    <div class="container">
      <SectionHeading index="01" eyebrow="Unsere Expertise">
        <Fragment slot="title"><span id="leistungen-title">Drei Disziplinen.<br />Ein klarer Anspruch.</span></Fragment>
        <Fragment slot="intro">Ein überzeugender Auftritt, mehr Sichtbarkeit und einfachere Abläufe. Wir verbinden Webdesign, Marketing und KI zu Lösungen, die zusammenpassen und dein Unternehmen weiterbringen.</Fragment>
      </SectionHeading>
      <div class="grid-3">
        <ServiceCard index="01" title="Websites & Webdesign" text="Wir gestalten und entwickeln Websites, die dein Angebot verständlich machen, Vertrauen schaffen und den Weg zur Anfrage erleichtern. Durchdacht im Design, intuitiv in der Bedienung und auf jedem Gerät überzeugend." tags={['Design', 'Entwicklung', 'Optimierung']} href="/websites">
          <Illustration slot="visual" zoom="mobile" src={imgWebsites} alt="Isometrische Illustration: drei übereinanderliegende Ebenen für Design, Entwicklung und Optimierung einer Website" />
        </ServiceCard>
        <ServiceCard index="02" title="Marketing & Social Media" text="Wir machen sichtbar, was dein Unternehmen auszeichnet. Mit einer klaren Strategie, relevanten Inhalten und gezielten Kampagnen sprechen wir die Menschen an, die zu deinem Angebot passen." tags={['Strategie', 'Inhalte', 'Kanäle']} href="/marketing">
          <Illustration slot="visual" zoom="mobile" src={imgMarketing} alt="Isometrische Illustration: Strategie, Inhalte und Kanäle als Plattform mit Signalen, die Menschen erreichen" />
        </ServiceCard>
        <ServiceCard index="03" title="KI & Automatisierung" text="Wir verbinden deine Systeme, automatisieren wiederkehrende Aufgaben und integrieren digitale Assistenten in deinen Arbeitsalltag. Mit passender Beratung und einer Umsetzung, die dein Team entlastet." tags={['Workflows', 'Assistenten', 'Beratung']} href="/ki-automatisierung">
          <Illustration slot="visual" zoom="mobile" src={imgKi} alt="Isometrische Illustration: Fließband mit automatisiertem Ablauf, Assistent und Ablaufdiagramm für KI und Automatisierung" />
        </ServiceCard>
      </div>
    </div>
  </section>

  <section class="section" data-theme="dark" aria-labelledby="zusammen-title">
    <div class="container">
      <SectionHeading index="02" eyebrow="Zusammenspiel">
        <Fragment slot="title"><span id="zusammen-title">Gut für sich.<br />Besser zusammen.</span></Fragment>
        <Fragment slot="intro">Deine Website erklärt dein Angebot. Dein Marketing bringt die passenden Menschen dorthin. KI und Automatisierung helfen dir, Anfragen und Aufgaben effizient zu bearbeiten. Wir stimmen diese Bereiche aufeinander ab, damit aus einzelnen Maßnahmen ein durchdachter Gesamtauftritt entsteht.</Fragment>
      </SectionHeading>
      <ol class="grid-3" style="padding:0;list-style:none">
        <ProcessStep number="01" title="Auftritt stärken" text="Eine Website, die dein Unternehmen auf den Punkt bringt und den Weg zur Kontaktaufnahme einfach macht." />
        <ProcessStep number="02" title="Menschen erreichen" text="Inhalte und Kampagnen, die deine Zielgruppe ansprechen und Interesse an deinem Angebot wecken." />
        <ProcessStep number="03" title="Arbeit erleichtern" text="Intelligente Werkzeuge und automatisierte Abläufe, die wiederkehrende Aufgaben übernehmen und dein Team entlasten." />
      </ol>
      <p class="note">Du startest dort, wo du Unterstützung brauchst. Wir behalten das Ganze im Blick und entwickeln deinen nächsten Schritt gemeinsam mit dir.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="ablauf-title">
    <div class="container">
      <SectionHeading index="03" eyebrow="So arbeiten wir">
        <Fragment slot="title"><span id="ablauf-title">Klar im Ablauf.<br />Offen im Austausch.</span></Fragment>
      </SectionHeading>
      <ol class="grid-4">
        {processSteps.map((s) => <ProcessStep {...s} />)}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="about-title" style="padding-top:0">
    <div class="container">
      <SectionHeading index="04" eyebrow="Über uns">
        <Fragment slot="title"><span id="about-title">Ein Studio.<br />Drei Disziplinen.</span></Fragment>
      </SectionHeading>
      {about.intro
        ? <p class="about-text">{about.intro}</p>
        : <p class="about-text"><span class="placeholder">Platzhalter: 2 Sätze zu uns – wer, warum, Haltung</span></p>}
      <Button variant="link" href="/ueber-uns">Mehr über uns</Button>
    </div>
  </section>

  <section class="section" data-theme="dark" aria-labelledby="cta-title">
    <div class="container cta-block">
      <p class="gv-eyebrow" style="margin-bottom:var(--space-6)"><span class="gv-eyebrow-index">05</span><span aria-hidden="true"> / </span>Kontakt</p>
      <h2 class="display-cta" id="cta-title">Was hast du vor<span class="gv-accent">?</span></h2>
      <p class="lead">Erzähl uns in ein paar Sätzen von deinem Projekt. Wir melden uns persönlich.</p>
      <Button href="/kontakt">Projekt besprechen</Button>
    </div>
  </section>
</Base>
