---
// Schablone der drei Leistungsseiten als Scroll-Geschichte: Text links, die passende Ebene haftet rechts
// und ändert je Kapitel Blickwinkel und Ausschnitt (Zeitachse in src/scripts/story/timeline.ts).
// Ohne 3D (Handy, reduzierte Bewegung) bleibt eine ruhige Textseite mit Standbild im Seitenkopf.
import Base from './Base.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProcessStep from '../components/ProcessStep.astro';
import Illustration from '../components/Illustration.astro';
import ChapterNav from '../components/ChapterNav.astro';
import StoryLoader from '../components/StoryLoader.astro';
import { processSteps } from '../data/process';

interface Props {
  title: string;
  description: string;
  /** Welche Ebene die Bühne zeigt */
  story: 'websites' | 'marketing' | 'ki';
  eyebrow: string;
  /** Zwei kurze Aussagen, getrennt durch "|" */
  headline: string;
  intro: string;
  situation: string[];
  services: string[];
  benefits: string[];
  note?: string;
  image?: { src: ImageMetadata; alt: string };
}
const { title, description, story, eyebrow, headline, intro, situation, services, benefits, note, image } = Astro.props;
const [h1a, h1b] = headline.split('|');
const nr = (i: number) => String(i + 1).padStart(2, '0');

const chapters = [
  { id: 'start', label: 'Start' },
  { id: 'ausgangslage', label: 'Ausgangslage' },
  { id: 'leistungen', label: 'Was wir tun' },
  { id: 'nutzen', label: 'Dein Nutzen' },
  { id: 'ablauf', label: 'So arbeiten wir' },
];
---
<Base title={title} description={description}>
  <div class="story" data-story={story}>
    <div class="story-stage" aria-hidden="true"><canvas id="story-canvas"></canvas></div>

    <section class="hero chapter chapter-intro service-hero" data-chapter="hero" id="start">
      <div class="container">
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="display">{h1a}<br />{h1b}</h1>
        <div class="hero-lower">
          <p class="lead">{intro}</p>
          <div class="hero-actions hero-actions-end"><Button href="/kontakt">Projekt besprechen</Button></div>
        </div>
        {image && <div class="illustration-wide hero-fallback"><Illustration src={image.src} alt={image.alt} size="wide" zoom="always" loading="eager" /></div>}
      </div>
    </section>

    <section class="chapter chapter-step" data-chapter="ausgangslage" id="ausgangslage" aria-labelledby="s1">
      <div class="container chapter-grid">
        <div class="chapter-text">
          <p class="gv-eyebrow"><span class="gv-eyebrow-index">01</span><span aria-hidden="true"> / </span>Typische Ausgangslage</p>
          <h2 class="heading-1" id="s1">Der Ausgangspunkt.<br />Ehrlich benannt.</h2>
          <ul class="chapter-list">{situation.map((t, i) => <li><span class="chapter-list-index">{nr(i)}</span><p class="chapter-list-text">{t}</p></li>)}</ul>
        </div>
      </div>
    </section>

    <section class="chapter chapter-step" data-chapter="leistungen" id="leistungen" aria-labelledby="s2">
      <div class="container chapter-grid">
        <div class="chapter-text">
          <p class="gv-eyebrow"><span class="gv-eyebrow-index">02</span><span aria-hidden="true"> / </span>Was wir tun</p>
          <h2 class="heading-1" id="s2">Mögliche Leistungen.<br />Nach deinem Bedarf.</h2>
          <p class="lead">Du musst nicht alles nehmen. Wir klären gemeinsam, was für dein Vorhaben sinnvoll ist.</p>
          <ul class="chapter-list">{services.map((t, i) => <li><span class="chapter-list-index">{nr(i)}</span><p class="chapter-list-text">{t}</p></li>)}</ul>
        </div>
      </div>
    </section>

    <section class="chapter chapter-step" data-chapter="nutzen" id="nutzen" aria-labelledby="s3">
      <div class="container chapter-grid">
        <div class="chapter-text">
          <p class="gv-eyebrow"><span class="gv-eyebrow-index">03</span><span aria-hidden="true"> / </span>Dein Nutzen</p>
          <h2 class="heading-1" id="s3">Was du davon hast.<br />Konkret.</h2>
          <ul class="chapter-list">{benefits.map((t, i) => <li><span class="chapter-list-index">{nr(i)}</span><p class="chapter-list-text">{t}</p></li>)}</ul>
          {note && <p class="note">{note}</p>}
        </div>
      </div>
    </section>

    <section class="chapter chapter-step" data-chapter="ablauf" id="ablauf" aria-labelledby="s4">
      <div class="container">
        <SectionHeading index="04" eyebrow="So arbeiten wir">
          <Fragment slot="title"><span id="s4">Klar im Ablauf.<br />Offen im Austausch.</span></Fragment>
        </SectionHeading>
        <ol class="grid-4">{processSteps.map((s) => <ProcessStep {...s} />)}</ol>
      </div>
    </section>

    <ChapterNav items={chapters} label="Kapitel dieser Leistungsseite" />
  </div>

  <section class="section" data-theme="dark" aria-labelledby="cta-title">
    <div class="container cta-block">
      <h2 class="display-cta" id="cta-title">Was hast du vor<span class="gv-accent">?</span></h2>
      <p class="lead">Erzähl uns in ein paar Sätzen von deinem Projekt. Wir melden uns persönlich.</p>
      <Button href="/kontakt">Projekt besprechen</Button>
    </div>
  </section>
  <StoryLoader />
</Base>
